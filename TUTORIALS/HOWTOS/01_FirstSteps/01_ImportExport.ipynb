    },
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 600x600 with 2 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "Field1.plot()\n",
    "Field2.plot()\n",
    "Field3.plot()"
   ]
  },
